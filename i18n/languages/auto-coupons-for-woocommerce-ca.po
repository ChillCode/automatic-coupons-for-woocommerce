#. Text to show when cart coupons are applied to cart, %1$s can be amount or percentage quantity.
#: includes/class-autocoupons.php:545
#, php-format
msgid "A %1$s discount has been applied to the cart."
msgstr "S'ha aplicat un descompte de %1$s al carretó."

#. Text to show when product coupons are applied to products, %1$s can be amount or percentage quantity and %2$s the name of the product.
#: includes/class-autocoupons.php:562
#, php-format
msgid "A %1$s discount has been applied to the following product %2$s."
msgstr "S'ha aplicat un descompte de %1$s al següent producte %2$s."

#: includes/class-autocoupons.php:294
msgid "Allow automatic application"
msgstr "Permet l'aplicació automàtica"

#: includes/class-autocoupons.php:258
msgid "Allow coupons to apply automatically"
msgstr "Permet que els cupons s'apliquin automàticament"

#: includes/class-autocoupons.php:295
msgid "Apply this coupon automatically as a discount."
msgstr "Aplica aquest cupó automàticament com a descompte."

#. Description of the plugin
#| msgid "Apply WooCommerce coupons automatically as a discount."
msgid "Apply WooCommerce coupons automatically as discounts."
msgstr "Apliqueu els cupons de WooCommerce automàticament com a descompte."

#. Name of the plugin
msgid "Auto Coupons for WooCommerce"
msgstr "Cupons automàtics per a WooCommerce"

#: includes/class-autocoupons.php:74
msgid ""
"Auto Coupons for WooCommerce requires WooCommerce to be installed and active."
msgstr ""
"Els cupons automàtics per a WooCommerce requereixen que WooCommerce estigui "
"instal·lat i actiu."

#. Author of the plugin
msgid "Chillcode"
msgstr "Chillcode"

#: includes/class-autocoupons.php:259
msgid "Coupons can be applied automatically without user interaction."
msgstr ""
"Els cupons es poden aplicar automàticament sense la interacció de l'usuari."

#: includes/class-autocoupons.php:401
msgid "Discount type"
msgstr "Tipus de descompte"

#. Author URI of the plugin
msgid "https://github.com/chillcode/"
msgstr "https://github.com/chillcode/"

#. URI of the plugin
msgid "https://github.com/chillcode/automatic-coupons-for-woocommerce"
msgstr "https://github.com/chillcode/automatic-coupons-for-woocommerce"

#: includes/class-autocoupons.php:268
msgid "Remove all coupons already applied automatically to carts"
msgstr ""
"Elimina tots els cupons que ja s'han aplicat automàticament als carrets de "
"la compra"

#: includes/class-autocoupons.php:269
msgid ""
"Remove all coupons already applied automatically to carts when \"Allow "
"coupons to apply automatically\" is unchecked."
msgstr ""
"Elimina tots els cupons que ja s'han aplicat automàticament als carrets de "
"la compra quan l'opció \"Permet que els cupons s'apliquin automàticament\" "
"no està marcada."

#: includes/class-autocoupons.php:249
msgid "Remove all coupons already applied to carts"
msgstr "Elimina tots els cupons ja aplicats als carrets de la compra"

#: includes/class-autocoupons.php:250
msgid ""
"Remove all coupons already applied to carts when \"Enable the use of coupon "
"codes\" is unchecked."
msgstr ""
"Elimina tots els cupons ja aplicats als carrets de la compra quan \"Activa "
"l'ús de codis de cupó\" no està marcat."
